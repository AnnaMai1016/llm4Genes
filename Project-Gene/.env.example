# Copy this file to `.env` in this same directory and fill in real values.

# Where PaperSearch's manifest.json lives (leave blank for the default: ../PaperSearch/data/manifest.json)
MANIFEST_PATH=

MINERU_BIN=mineru
# pipeline: CPU-only, no GPU needed. vlm-engine/hybrid-engine: much higher
# quality but need a GPU Slurm allocation + torch/vllm installed.
MINERU_BACKEND=pipeline
MINERU_LANG=en

# --- Step 3: LLM extraction (extract.py) ---
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-5.4-mini
EXTRACTION_LOG_DIR=