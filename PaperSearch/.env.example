# Copy this file to `.env` in this same directory and fill in real values.
# PaperSearch/.env holds no secrets besides your SMTP password — still, never commit it.

# --- Required by NCBI Eutils / CrossRef / Unpaywall usage policies (not secrets, just contact info) ---
ENTREZ_EMAIL=you@your-institution.edu
NCBI_API_KEY=
CROSSREF_MAILTO=you@your-institution.edu
UNPAYWALL_EMAIL=you@your-institution.edu

# --- Search scope ("||"-separated queries) ---
SEARCH_QUERIES=SWEET transporter gene phenotype||SWEET family sugar transporter maize||SWEET family sugar transporter rice
MAX_RESULTS_PER_QUERY=100
# Leave blank to search all-time; set once you run this daily so each run only looks at new papers.
SEARCH_RECENT_DAYS=

# --- Storage (leave blank to use the defaults: PaperSearch/data, ../Project-Gene) ---
PAPERSEARCH_DATA_DIR=
MINERU_OUTPUT_DIR=
MINERU_BIN=mineru
MINERU_BACKEND=vlm

# --- Institutional library-proxy fallback (e.g. EZproxy) — off by default. ---
# MANUAL, SINGLE-PAPER USE ONLY — library terms explicitly prohibit systematic
# / robotic downloading through this proxy, and publishers cut off proxied
# access for the WHOLE INSTITUTION (not just you) if they detect that pattern.
# It is intentionally NOT part of the automated search/download pipeline; only
# call download_manager.fetch_via_institutional_proxy(doi) by hand, one paper
# at a time. See sources/institutional_proxy.py for the one-time setup (find
# your library's proxy login URL, log into it once in a real browser, export
# cookies with e.g. the "Get cookies.txt LOCALLY" extension).
INSTITUTIONAL_PROXY_ENABLED=false
INSTITUTIONAL_PROXY_URL_TEMPLATE=
INSTITUTIONAL_PROXY_COOKIES_FILE=

# --- Daily email digest switch (off by default) ---
EMAIL_DIGEST_ENABLED=false
EMAIL_DIGEST_RECIPIENT=xxx@xxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=